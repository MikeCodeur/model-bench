{
  "opus-5-5": {
    "label": "Opus 5.5 (Claude Code)",
    "model_id": "claude-opus-5-5",
    "command": "claude -p --model claude-opus-5-5 --dangerously-skip-permissions --setting-sources \"\" --strict-mcp-config --disable-slash-commands --no-session-persistence --output-format stream-json --verbose {prompt}",
    "version_command": "claude --version",
    "parser": "claude-stream-json",
    "billing": "subscription"
  },
  "haiku-4-5": {
